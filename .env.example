# ==============================================================================
# HarnessX Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration
# Set USE_VERTEX=false for local development with Google AI Studio
USE_VERTEX=false
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI Settings (required if USE_VERTEX=true)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json # (Optional: prefer ADC via 'gcloud auth application-default login')

# Harness Configuration Defaults
HARNESS_DEFAULT_MODE=HYBRID          # GUIDED, DIRECT, or HYBRID
HARNESS_MODEL_NAME=gemini-2.5-flash  # Default coding model

# ContextT4 Thresholds
CONTEXT_SOFT_THRESHOLD=0.60         # Trigger elision when context reaches 60% of window
CONTEXT_HARD_THRESHOLD=0.85         # Trigger LLM summarization when context reaches 85%
CONTEXT_WINDOW_LIMIT=128000         # Effective window size for token tracking

# AgentGuard Safety Limits
GUARD_MAX_TOOL_CALLS=30             # Maximum tool calls before halting
GUARD_MAX_LOOP_ATTEMPTS=5           # Warning after 5 repeated tool calls
GUARD_MAX_FAILED_REPEATS=8          # Terminate if 8 repeated failing calls
GUARD_TIMEOUT_SECONDS=300           # Global execution timeout per session

# Workspace Sandbox
WORKSPACE_BASE_DIR=./workspaces     # Root folder for agent-generated workspaces
ALLOW_UNSAFE_HOST_EXECUTION=false   # Restrict bash commands strictly within workspace
